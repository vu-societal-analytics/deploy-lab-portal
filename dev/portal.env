# The portal in development mode (AUTH_DEV_MODE): no OIDC provider, no Caddy, emails in the terminal.
# Paths relative to portal/, where it runs.
AUTH_DEV_MODE=true
PORTAL_LISTEN_HOST=127.0.0.1
REGISTRATION_OPEN=true
SERVICES_FILE=../dev/config/services.yml
ADMINS_FILE=../dev/config/admins.yml
DATABASE_FILE=../dev/.work/portal.db
