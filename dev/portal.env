# The portal's settings in the dev setup (paths relative to portal/, where it runs)
LAB_DOMAIN=lab.localhost
OIDC_HOST=http://localhost:8080/realms/dev
OIDC_CLIENT_ID=lab-portal
OIDC_CLIENT_SECRET=dev-secret
ACCOUNT_URL=http://localhost:8080/realms/dev/account
REGISTRATION_OPEN=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=lab-portal@example.org
SERVICES_FILE=../dev/config/services.yml
ADMINS_FILE=../dev/config/admins.yml
CADDY_FILE=../dev/.work/caddy/Caddyfile
DATABASE_FILE=../dev/.work/portal.db
# Caddy runs in Docker, the portal on this computer
PORTAL_UPSTREAM=host.docker.internal:3000
# Keycloak on plain http, and Caddy's own local certificates
TEST_ALLOW_HTTP_ISSUER=true
TEST_LOCAL_CERTS=true
