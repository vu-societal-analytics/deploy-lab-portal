{
  "realm": "dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": true,
  "ssoSessionIdleTimeout": 600,
  "ssoSessionMaxLifespan": 1800,
  "browserFlow": "browser-amr",
  "authenticationFlows": [
    {
      "alias": "browser-amr",
      "description": "cookie, or password and (when configured) OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-amr-forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-amr-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "amr-pwd"
        },
        {
          "flowAlias": "browser-amr-otp",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-amr-otp",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorConfig": "amr-otp"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "1800"
      }
    },
    {
      "alias": "amr-otp",
      "config": {
        "default.reference.value": "mfa",
        "default.reference.maxAge": "1800"
      }
    }
  ],
  "clients": [
    {
      "clientId": "lab-portal",
      "name": "Lab portal",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://lab.localhost/callback"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://lab.localhost/signed-out",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@example.org",
      "email": "admin@example.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "realmRoles": [
        "default-roles-dev"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "dev authenticator",
          "secretData": "{\"value\": \"JBSWY3DPEHPK3PXP\"}",
          "credentialData": "{\"subType\": \"totp\", \"digits\": 6, \"period\": 30, \"algorithm\": \"HmacSHA1\", \"counter\": 0}"
        }
      ],
      "id": "dev00000-0000-4000-8000-00000000ad01"
    },
    {
      "username": "member@example.org",
      "email": "member@example.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Member",
      "lastName": "Dev",
      "realmRoles": [
        "default-roles-dev"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "newcomer@example.org",
      "email": "newcomer@example.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Newcomer",
      "lastName": "Dev",
      "realmRoles": [
        "default-roles-dev"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-password",
          "temporary": false
        }
      ]
    }
  ],
  "smtpServer": {
    "host": "mail",
    "port": "1025",
    "from": "keycloak@example.org",
    "fromDisplayName": "Keycloak (dev)",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  }
}