# Copy to .env (readable only by sal: chmod 600) and fill in.

# The lab zone: the portal at https://<LAB_DOMAIN>, the services at https://<name>.<LAB_DOMAIN>
LAB_DOMAIN=lab.societal-analytics.nl
# For Let's Encrypt's expiry notices
ACME_EMAIL=

# The OIDC provider (the idp realm of Keycloak, as for AmCAT and AnnoTinder), and the portal's client there
OIDC_HOST=https://auth.societal-analytics.nl/realms/idp
OIDC_CLIENT_ID=lab-portal
OIDC_CLIENT_SECRET=
# Which claim counts as a second factor (the lab's Authentication standard)
OIDC_MFA_CLAIM=amr:mfa
# Admin changes need a login with a second factor of at most this many seconds ago
AUTH_STEP_UP_MAX_AGE=600

# The portal's own sessions: signed out after this long without use (seconds), and at most this long
# in total: OWASP's idle and absolute timeouts, with NIST's numbers for logins with a second factor.
# An app can have its own limits in services.yml (session_idle, session_max). Signing out in Keycloak
# ends them too (back-channel logout).
SESSION_IDLE=1800
SESSION_MAX=43200

# The realm lets people create an account themselves (they then request membership in the portal);
# only changes the texts on the portal
REGISTRATION_OPEN=true

# Email (optional): notifications to the admins about membership requests (at most one per hour,
# and a daily reminder at REMINDER_TIME while requests are pending), invitations, and a welcome to new members
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), or tls (port 465)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TIME=16:00
