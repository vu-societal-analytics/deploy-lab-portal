# The portal's settings for the end-to-end test (not for production)
LAB_DOMAIN=lab.test
OIDC_HOST=http://localhost:8080/realms/test
OIDC_CLIENT_ID=lab-portal
OIDC_CLIENT_SECRET=e2e-secret
ACCOUNT_URL=http://localhost:8080/realms/test/account
REGISTRATION_OPEN=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=lab@example.org
SERVICES_FILE=/config/services.yml
ADMINS_FILE=/config/admins.yml
CADDY_FILE=/caddy/Caddyfile
DATABASE_FILE=/data/portal.db
BACKUP_DIR=/backups
TEST_ALLOW_HTTP_ISSUER=true
TEST_LOCAL_CERTS=true
